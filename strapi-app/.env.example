# Names only. Copy this file to .env and fill in the values. .env is git-ignored.

# Server
HOST=
PORT=

# Secrets (random values, generated per machine)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (DATABASE_CLIENT is sqlite or postgres)
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=
# Must be set explicitly: an empty value counts as set and breaks the SQLite path. Example: .tmp/data.db
DATABASE_FILENAME=

# Deliberate setting: switches off Strapi's anonymous telemetry so no background calls run during load tests.
STRAPI_TELEMETRY_DISABLED=
