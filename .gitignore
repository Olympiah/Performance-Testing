# Secrets: real values live in .env, only the names go in .env.example
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
strapi-app/build/
strapi-app/dist/
strapi-app/.strapi/
strapi-app/.cache/
# Strapi rewrites this update-check cache on every start (latest version and a timestamp), so tracking it only creates noise
strapi-app/.strapi-updater.json

# Databases and uploaded files: generated by the app and the data generator
*.db
*.db-shm
*.db-wal
strapi-app/.tmp/
strapi-app/public/uploads/*
!strapi-app/public/uploads/.gitkeep

# Saved database snapshots used to reset between runs
snapshots/
*.dump

# Generated files that can hold tokens
.generated/

# Raw test output: only summaries and graphs are copied into docs/
results/

# Logs and OS files
*.log
Thumbs.db
